<?xml version="1.0" encoding="utf-8"?>
<!-- Forterm: colours are roles; Services/EditorSyntax.cs gives them the colours of the terminal scheme. -->
<SyntaxDefinition name="Makefile" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment"/>
  <Color name="Keyword"/>
  <Color name="String"/>
  <Color name="Number"/>
  <Color name="Key"/>
  <Color name="Function"/>
  <Color name="Type"/>
  <Color name="Constant"/>
  <Color name="Variable"/>
  <Color name="Operator"/>
  <Color name="Heading"/>
  <Color name="Good"/>
  <Color name="Warning"/>
  <Color name="Bad"/>
  <RuleSet>
    <Span color="Comment"><Begin>(?&lt;=^|\s)\#</Begin></Span>
    <Rule color="Function">^[\w./%$(){}-]{1,200}(\s{1,8}[\w./%$(){}-]{1,200}){0,20}(?=\s{0,8}:([^=]|$))</Rule>
    <Rule color="Key">^\s{0,200}(export\s{1,20}|override\s{1,20})?[A-Za-z_][\w.-]{0,100}(?=\s{0,100}[:+?!]?=)</Rule>
    <Rule color="Variable">\$\([^)]{0,200}\)|\$\{[^}]{0,200}\}|\$[@&lt;^?*%+]|\$\$\w+</Rule>
    <Keywords color="Keyword"><Word>ifeq</Word><Word>ifneq</Word><Word>ifdef</Word><Word>ifndef</Word><Word>else</Word><Word>endif</Word><Word>include</Word><Word>define</Word><Word>endef</Word><Word>export</Word><Word>unexport</Word><Word>override</Word><Word>vpath</Word></Keywords>
    <Span color="String"><Begin>&quot;</Begin><End>&quot;</End><RuleSet><Span begin="\\" end="."/></RuleSet></Span>
    <Span color="String"><Begin>&#x27;</Begin><End>&#x27;</End></Span>
    <Rule color="Type">(?&lt;=\s)--?[A-Za-z][\w-]*</Rule>
    <Rule color="Number">\b(0[xX][0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?)\b</Rule>
  </RuleSet>
</SyntaxDefinition>
