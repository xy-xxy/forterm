<?xml version="1.0" encoding="utf-8"?>
<!-- Forterm: colours are roles; Services/EditorSyntax.cs gives them the colours of the terminal scheme. -->
<SyntaxDefinition name="Perl" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment"/>
  <Color name="Keyword"/>
  <Color name="String"/>
  <Color name="Number"/>
  <Color name="Key"/>
  <Color name="Function"/>
  <Color name="Type"/>
  <Color name="Constant"/>
  <Color name="Variable"/>
  <Color name="Operator"/>
  <Color name="Heading"/>
  <Color name="Good"/>
  <Color name="Warning"/>
  <Color name="Bad"/>
  <RuleSet>
    <Span color="Comment"><Begin>(?&lt;=^|\s)\#</Begin></Span>
    <Span color="String"><Begin>&quot;</Begin><End>&quot;</End><RuleSet><Span begin="\\" end="."/><Rule color="Variable">[$@%][A-Za-z_]\w*</Rule></RuleSet></Span>
    <Span color="String"><Begin>&#x27;</Begin><End>&#x27;</End></Span>
    <Rule color="Variable">[$@%]\{?[A-Za-z_]\w*\}?|\$[0-9_&amp;!@]</Rule>
    <Keywords color="Keyword"><Word>my</Word><Word>our</Word><Word>local</Word><Word>use</Word><Word>no</Word><Word>package</Word><Word>sub</Word><Word>return</Word><Word>if</Word><Word>elsif</Word><Word>else</Word><Word>unless</Word><Word>while</Word><Word>until</Word><Word>for</Word><Word>foreach</Word><Word>do</Word><Word>last</Word><Word>next</Word><Word>redo</Word><Word>die</Word><Word>warn</Word><Word>print</Word><Word>printf</Word><Word>say</Word><Word>open</Word><Word>close</Word><Word>chomp</Word><Word>split</Word><Word>join</Word><Word>map</Word><Word>grep</Word><Word>sort</Word><Word>keys</Word><Word>values</Word><Word>each</Word><Word>push</Word><Word>pop</Word><Word>shift</Word><Word>unshift</Word><Word>defined</Word><Word>undef</Word><Word>exists</Word><Word>delete</Word><Word>ref</Word><Word>bless</Word><Word>eq</Word><Word>ne</Word><Word>lt</Word><Word>gt</Word><Word>le</Word><Word>ge</Word><Word>cmp</Word><Word>and</Word><Word>or</Word><Word>not</Word></Keywords>
    <Rule color="Number">\b(0[xX][0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?)\b</Rule>
  </RuleSet>
</SyntaxDefinition>
