<?xml version="1.0" encoding="utf-8"?>
<!-- Forterm: colours are roles; Services/EditorSyntax.cs gives them the colours of the terminal scheme. -->
<SyntaxDefinition name="SQL" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment"/>
  <Color name="Keyword"/>
  <Color name="String"/>
  <Color name="Number"/>
  <Color name="Key"/>
  <Color name="Function"/>
  <Color name="Type"/>
  <Color name="Constant"/>
  <Color name="Variable"/>
  <Color name="Operator"/>
  <Color name="Heading"/>
  <Color name="Good"/>
  <Color name="Warning"/>
  <Color name="Bad"/>
  <RuleSet ignoreCase="true">
    <Span color="Comment"><Begin>--</Begin></Span>
    <Span color="Comment"><Begin>^\s*\#</Begin></Span>
    <Span color="Comment" multiline="true"><Begin>/\*</Begin><End>\*/</End></Span>
    <Span color="String"><Begin>&#x27;</Begin><End>&#x27;</End></Span>
    <Span color="String"><Begin>&quot;</Begin><End>&quot;</End></Span>
    <Span color="Key"><Begin>`</Begin><End>`</End></Span>
    <Keywords color="Keyword"><Word>select</Word><Word>from</Word><Word>where</Word><Word>and</Word><Word>or</Word><Word>not</Word><Word>in</Word><Word>is</Word><Word>null</Word><Word>like</Word><Word>between</Word><Word>exists</Word><Word>group</Word><Word>by</Word><Word>having</Word><Word>order</Word><Word>limit</Word><Word>offset</Word><Word>union</Word><Word>all</Word><Word>distinct</Word><Word>as</Word><Word>join</Word><Word>inner</Word><Word>left</Word><Word>right</Word><Word>full</Word><Word>outer</Word><Word>cross</Word><Word>on</Word><Word>using</Word><Word>insert</Word><Word>into</Word><Word>values</Word><Word>update</Word><Word>set</Word><Word>delete</Word><Word>create</Word><Word>alter</Word><Word>drop</Word><Word>table</Word><Word>database</Word><Word>schema</Word><Word>view</Word><Word>index</Word><Word>unique</Word><Word>primary</Word><Word>foreign</Word><Word>key</Word><Word>references</Word><Word>constraint</Word><Word>default</Word><Word>check</Word><Word>trigger</Word><Word>procedure</Word><Word>function</Word><Word>begin</Word><Word>end</Word><Word>commit</Word><Word>rollback</Word><Word>transaction</Word><Word>grant</Word><Word>revoke</Word><Word>to</Word><Word>with</Word><Word>recursive</Word><Word>case</Word><Word>when</Word><Word>then</Word><Word>else</Word><Word>if</Word><Word>truncate</Word><Word>explain</Word><Word>analyze</Word><Word>show</Word><Word>use</Word><Word>describe</Word><Word>desc</Word><Word>asc</Word><Word>add</Word><Word>column</Word><Word>modify</Word><Word>rename</Word><Word>returning</Word><Word>lock</Word><Word>tables</Word><Word>unlock</Word><Word>replace</Word><Word>ignore</Word><Word>on_duplicate</Word><Word>cascade</Word><Word>restrict</Word><Word>partition</Word><Word>engine</Word><Word>charset</Word><Word>collate</Word><Word>auto_increment</Word><Word>comment</Word><Word>temporary</Word></Keywords>
    <Keywords color="Type"><Word>int</Word><Word>integer</Word><Word>bigint</Word><Word>smallint</Word><Word>tinyint</Word><Word>decimal</Word><Word>numeric</Word><Word>float</Word><Word>double</Word><Word>real</Word><Word>char</Word><Word>varchar</Word><Word>text</Word><Word>longtext</Word><Word>mediumtext</Word><Word>blob</Word><Word>json</Word><Word>jsonb</Word><Word>date</Word><Word>time</Word><Word>datetime</Word><Word>timestamp</Word><Word>year</Word><Word>boolean</Word><Word>bool</Word><Word>serial</Word><Word>bigserial</Word><Word>uuid</Word><Word>enum</Word></Keywords>
    <Keywords color="Function"><Word>count</Word><Word>sum</Word><Word>avg</Word><Word>min</Word><Word>max</Word><Word>coalesce</Word><Word>ifnull</Word><Word>nullif</Word><Word>concat</Word><Word>concat_ws</Word><Word>substring</Word><Word>substr</Word><Word>length</Word><Word>lower</Word><Word>upper</Word><Word>trim</Word><Word>now</Word><Word>current_timestamp</Word><Word>date_format</Word><Word>from_unixtime</Word><Word>unix_timestamp</Word><Word>round</Word><Word>floor</Word><Word>ceil</Word><Word>cast</Word><Word>convert</Word><Word>row_number</Word><Word>rank</Word><Word>over</Word></Keywords>
    <Keywords color="Constant"><Word>true</Word><Word>false</Word><Word>null</Word></Keywords>
    <Rule color="Variable">@{1,2}\w+|:\w+</Rule>
    <Rule color="Number">\b(0[xX][0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?)\b</Rule>
  </RuleSet>
</SyntaxDefinition>
