<?xml version="1.0" encoding="utf-8"?>
<!-- Forterm: colours are roles; Services/EditorSyntax.cs gives them the colours of the terminal scheme. -->
<SyntaxDefinition name="Nginx" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment"/>
  <Color name="Keyword"/>
  <Color name="String"/>
  <Color name="Number"/>
  <Color name="Key"/>
  <Color name="Function"/>
  <Color name="Type"/>
  <Color name="Constant"/>
  <Color name="Variable"/>
  <Color name="Operator"/>
  <Color name="Heading"/>
  <Color name="Good"/>
  <Color name="Warning"/>
  <Color name="Bad"/>
  <RuleSet>
    <Span color="Comment"><Begin>(?&lt;=^|\s)\#</Begin></Span>
    <Span color="String"><Begin>&quot;</Begin><End>&quot;</End><RuleSet><Span begin="\\" end="."/><Rule color="Variable">\$\{[^}]{0,200}\}|\$\([\w\ ./-]{0,200}\)|\$[A-Za-z_]\w*|\$[0-9@\#?!*$-]</Rule></RuleSet></Span>
    <Span color="String"><Begin>&#x27;</Begin><End>&#x27;</End></Span>
    <Rule color="Variable">\$\w+</Rule>
    <Keywords color="Heading"><Word>http</Word><Word>server</Word><Word>location</Word><Word>upstream</Word><Word>events</Word><Word>stream</Word><Word>mail</Word><Word>map</Word><Word>geo</Word><Word>if</Word><Word>types</Word><Word>limit_except</Word></Keywords>
    <Rule color="Key">(?&lt;=^\s{0,200})[a-z_][a-z0-9_]{0,80}(?=[\s;])|(?&lt;=[{;]\s{0,20})[a-z_][a-z0-9_]{0,80}(?=[\s;])</Rule>
    <Keywords color="Constant"><Word>on</Word><Word>off</Word><Word>default</Word><Word>auto</Word><Word>none</Word><Word>any</Word><Word>all</Word><Word>last</Word><Word>break</Word><Word>redirect</Word><Word>permanent</Word></Keywords>
    <Rule color="Operator">(?&lt;=\s)(~\*?|\^~|=)(?=\s)|[{};]</Rule>
    <Rule color="Function">\b[a-z][a-z0-9+.-]{1,10}://[^\s&quot;\&#x27;&lt;&gt;)]+</Rule>
    <Rule color="Constant">\b(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}(:\d{1,5}|/\d{1,2})?\b</Rule>
    <Rule color="Number">\b\d+(\.\d+)?(%|[kKmMgGtT]i?[bB]?|ms|s|m|h|d|w)?\b</Rule>
    <Rule color="String">(?&lt;=\s)/[\w./@%+-]*</Rule>
  </RuleSet>
</SyntaxDefinition>
