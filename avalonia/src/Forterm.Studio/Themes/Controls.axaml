<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Forterm.Studio.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource St.Window}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Text}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{DynamicResource St.TextDim}"/></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource St.TextStrong}"/></Style>

  <!-- Flat icon buttons used everywhere (toolbar, title bar, pane actions, rail). -->
  <Style Selector="Button.flat, Button.pane-icon, Button.title-icon, Button.rail, Button.chip-close, Button.session-tab, Button.crumb">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource St.TextDim}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter, Button.pane-icon:pointerover /template/ ContentPresenter, Button.title-icon:pointerover /template/ ContentPresenter, Button.rail:pointerover /template/ ContentPresenter, Button.session-tab:pointerover /template/ ContentPresenter, Button.crumb:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.Hover}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Text}"/>
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter, Button.pane-icon:pressed /template/ ContentPresenter, Button.title-icon:pressed /template/ ContentPresenter, Button.rail:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.Pressed}"/>
  </Style>
  <Style Selector="Button.flat"><Setter Property="Padding" Value="5"/></Style>
  <Style Selector="Button.pane-icon"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Button.title-icon"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Button.rail"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Button.rail.on"><Setter Property="Foreground" Value="{DynamicResource St.Accent}"/></Style>
  <Style Selector="Button.rail:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Opacity" Value="0.35"/></Style>
  <Style Selector="Button.crumb"><Setter Property="Padding" Value="4,1"/><Setter Property="Foreground" Value="{DynamicResource St.Text}"/></Style>

  <!-- Pane tab chip ("文件工作区 ×"). -->
  <Style Selector="Border.pane-chip">
    <Setter Property="BorderBrush" Value="{DynamicResource St.Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="7,1,3,1"/>
    <Setter Property="Background" Value="{DynamicResource St.AccentSoft}"/>
  </Style>
  <Style Selector="Border.pane-chip.inactive">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.pane-chip TextBlock.chip-text"><Setter Property="Foreground" Value="{DynamicResource St.Accent}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.pane-chip.inactive TextBlock.chip-text"><Setter Property="Foreground" Value="{DynamicResource St.TextDim}"/></Style>
  <Style Selector="Button.chip-tab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.chip-tab:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource St.Accent}"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="MinWidth" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Padding" Value="3,0"/>
  </Style>
  <Style Selector="Border.badge TextBlock"><Setter Property="FontSize" Value="9.5"/><Setter Property="Foreground" Value="{DynamicResource St.OnAccent}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="MenuItem.danger"><Setter Property="Foreground" Value="{DynamicResource St.Danger}"/></Style>
  <Style Selector="ProgressBar.thin"><Setter Property="MinHeight" Value="3"/><Setter Property="Height" Value="3"/><Setter Property="CornerRadius" Value="2"/></Style>
  <Style Selector="Button.chip-close"><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource St.Accent}"/></Style>
  <Style Selector="Button.chip-close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource St.Hover}"/></Style>

  <!-- Session tabs in the title bar. -->
  <Style Selector="Button.session-tab">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="12,0,6,0"/>
    <Setter Property="CornerRadius" Value="6,6,0,0"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>
  <Style Selector="Button.session-tab.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.Window}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Accent}"/>
  </Style>

  <!-- "导航栏颜色": on a solid coloured title bar, icons and inactive tabs use its own text colour. -->
  <Style Selector="Border#TitleBar.solid Button.title-icon, Border#TitleBar.solid Button.session-tab">
    <Setter Property="Foreground" Value="{DynamicResource St.TitleBarText}"/>
  </Style>
  <Style Selector="Border#TitleBar.solid Button.title-icon:pointerover /template/ ContentPresenter, Border#TitleBar.solid Button.session-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.TitleBarHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.TitleBarText}"/>
  </Style>
  <Style Selector="Border#TitleBar.solid Button.session-tab.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.Window}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Accent}"/>
  </Style>
  <!-- The close "×" sits on the bar colour for inactive tabs and on the window colour for the active one. -->
  <Style Selector="Border#TitleBar.solid Button.session-tab Button.chip-close"><Setter Property="Foreground" Value="{DynamicResource St.TitleBarText}"/></Style>
  <Style Selector="Border#TitleBar.solid Button.session-tab.active Button.chip-close"><Setter Property="Foreground" Value="{DynamicResource St.Accent}"/></Style>

  <!-- Primary / secondary text buttons (dialogs, home). -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource St.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.OnAccent}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="18,6"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.AccentHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.OnAccent}"/>
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource St.Field}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource St.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Text}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="18,6"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource St.Hover}"/></Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource St.Field}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource St.Line}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource St.Field}"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource St.Accent}"/></Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource St.Line}"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>

  <!-- Trees use Studio's compact row theme. The file tree marks the selected row in solid green like the reference. -->
  <Style Selector="TreeView.files TreeViewItem, TreeView.library TreeViewItem">
    <Setter Property="Theme" Value="{StaticResource StudioTreeViewItem}"/>
  </Style>
  <Style Selector="TreeView.files TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource St.Selected}"/>
  </Style>
  <Style Selector="TreeView.files TreeViewItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource St.OnAccent}"/>
  </Style>

  <Style Selector="Button.status-chip">
    <Setter Property="Background" Value="{DynamicResource St.AccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Accent}"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.status-chip:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource St.Hover}"/><Setter Property="Foreground" Value="{DynamicResource St.Accent}"/></Style>

  <!-- Size and time of a file, when there is room (Views/WorkspaceView sets the classes). -->
  <Style Selector="TextBlock.file-size, TextBlock.file-time">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Opacity" Value="0.62"/>
    <Setter Property="FontFeatures" Value="tnum"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="TextBlock.file-size"><Setter Property="Width" Value="62"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style Selector="TextBlock.file-time"><Setter Property="Width" Value="88"/><Setter Property="Margin" Value="8,0,8,0"/></Style>
  <Style Selector="TreeView.sizes TextBlock.file-size, TreeView.times TextBlock.file-time"><Setter Property="IsVisible" Value="True"/></Style>

  <!-- Short messages and the command palette float above everything. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource St.Menu}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource St.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,9,8,9"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
    <Setter Property="BoxShadow" Value="0 6 20 0 #50000000"/>
  </Style>
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource St.Menu}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource St.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="BoxShadow" Value="0 14 44 0 #70000000"/>
  </Style>
  <Style Selector="Border.palette ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="CornerRadius" Value="5"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="Border.palette ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource St.AccentSoft}"/></Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource St.Accent}"/>
    <Setter Property="Padding" Value="4,1"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource St.Hover}"/><Setter Property="Foreground" Value="{DynamicResource St.Accent}"/></Style>

  <!-- Column borders say that they can be moved. -->
  <Style Selector="Thumb.splitter"><Setter Property="Background" Value="{DynamicResource St.Line}"/></Style>
  <Style Selector="Thumb.splitter:pointerover, Thumb.splitter:pressed"><Setter Property="Background" Value="{DynamicResource St.Accent}"/></Style>

  <!-- Files being dragged over the file column. -->
  <Style Selector="Border.drop">
    <Setter Property="Background" Value="#D91B2A22"/>
    <Setter Property="BorderBrush" Value="{DynamicResource St.Accent}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Margin" Value="6"/>
  </Style>

  <!-- Compact check box (table selection). -->
  <Style Selector="CheckBox.small">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="RenderTransform" Value="scale(0.78)"/>
  </Style>
</Styles>
