<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Forterm.Studio.ViewModels"
        xmlns:c="using:Forterm.Studio.Controls"
        x:Class="Forterm.Studio.Views.BastionAssetsWindow"
        x:DataType="vm:BastionAssetsViewModel"
        Title="{Binding Title}" Width="900" Height="600" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource St.Dialog}">
  <Window.Styles>
    <Style Selector="ListBox#AssetList ListBoxItem"><Setter Property="Padding" Value="6,3"/><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="ListBox#AssetList ComboBox"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="8,3"/></Style>
  </Window.Styles>
  <DockPanel Margin="14">
    <!-- search and the login state -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
      <TextBox Name="QueryBox" Text="{Binding Query}" PlaceholderText="名称或地址" IsEnabled="{Binding IsLoggedIn}" AutomationProperties.Name="搜索资产">
        <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/></TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="secondary" Content="搜索" Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearch}" Margin="8,0,0,0"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
        <Button Classes="primary" Content="登录" Command="{Binding LoginCommand}" IsVisible="{Binding IsLoggedOut}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="登录堡垒机"/>
        <Button Classes="secondary" Content="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}" IsEnabled="{Binding IsIdle}"/>
      </StackPanel>
    </Grid>
    <!-- paging and what happened -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:BusyRing Width="14" Height="14" Brush="{DynamicResource St.Accent}" IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
        <TextBlock Name="StatusText" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding PageText}" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding IsLoggedIn}"/>
      <Button Grid.Column="2" Classes="secondary" Content="上一页" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoBack}" Margin="0,0,6,0" IsVisible="{Binding IsLoggedIn}"/>
      <Button Grid.Column="3" Classes="secondary" Content="下一页" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoOn}" IsVisible="{Binding IsLoggedIn}"/>
    </Grid>
    <Border Background="{DynamicResource St.DialogSection}" CornerRadius="7" Padding="4">
      <Panel>
        <ListBox Name="AssetList" ItemsSource="{Binding Assets}" Background="Transparent" AutomationProperties.Name="资产">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:BastionAssetRow">
              <Grid ColumnDefinitions="2*,1.4*,*,1.3*,Auto,Auto" Margin="4,2">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Ip}" VerticalAlignment="Center" Classes="dim" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding TypeName}" VerticalAlignment="Center" Classes="dim" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" HorizontalAlignment="Stretch" Margin="8,0,0,0" AutomationProperties.Name="账号">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Classes="primary" Content="SSH" Command="{Binding SshCommand}" IsEnabled="{Binding Owner.IsIdle}" Margin="8,0,0,0" Padding="12,3" ToolTip.Tip="在 Forterm 里打开终端会话" AutomationProperties.Name="SSH"/>
                <Button Grid.Column="5" Classes="secondary" Content="SFTP" Command="{Binding SftpCommand}" IsEnabled="{Binding Owner.IsIdle}" Margin="6,0,0,0" Padding="12,3" ToolTip.Tip="在 Forterm 里打开文件会话" AutomationProperties.Name="SFTP"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="登录后在这里列出这个账户能访问的资产。" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoggedOut}"/>
      </Panel>
    </Border>
  </DockPanel>
</Window>
