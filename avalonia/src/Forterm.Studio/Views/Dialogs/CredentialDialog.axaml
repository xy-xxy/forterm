<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:Forterm.Studio.Views.Dialogs"
        xmlns:c="using:Forterm.Studio.Controls"
        x:Class="Forterm.Studio.Views.Dialogs.CredentialDialog"
        x:DataType="d:CredentialDialogModel"
        Title="认证" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource St.Dialog}">
  <DockPanel>
    <Grid Name="Header" DockPanel.Dock="Top" Height="40" Background="Transparent" ColumnDefinitions="40,*,40">
      <TextBlock Grid.Column="1" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="title" FontSize="13"/>
      <Button Grid.Column="2" Classes="flat" Name="CloseButton" HorizontalAlignment="Center" AutomationProperties.Name="取消">
        <c:StrokeIcon Data="{StaticResource Icon.Close}" Width="13" Height="13"/>
      </Button>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,4,16,16">
      <Button Classes="secondary" Name="CancelButton" Content="取消"/>
      <Button Classes="primary" Name="OkButton" Content="确定" IsDefault="True"/>
    </StackPanel>
    <Border Margin="16,0,16,12" Padding="14" Background="{DynamicResource St.DialogSection}" CornerRadius="6">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:StrokeIcon Data="{StaticResource Icon.Lock}" Brush="{DynamicResource St.Accent}"/>
          <TextBlock Text="{Binding Endpoint}" VerticalAlignment="Center" Classes="dim"/>
        </StackPanel>
        <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" IsVisible="{Binding HasInstruction}"/>
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="d:CredentialField">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding Prompt}" FontSize="12.5"/>
                <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="{Binding Mask}" AutomationProperties.Name="{Binding Prompt}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="仅用于本次连接，不保存，也不会在断线后自动重试。" Classes="dim" FontSize="11.5" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
