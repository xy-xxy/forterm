<Style Selector="Button.protocol-mode.active"><Setter Property="Foreground" Value="#4CBD83"/><Setter Property="Background" Value="#23352B"/></Style>
<Style Selector="ListBox.file-entry-list"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="ListBox.file-entry-list ListBoxItem"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
<Style Selector="TreeView.file-directory-tree"><Setter Property="Background" Value="Transparent"/></Style>
<Style Selector="TreeView.file-directory-tree TreeViewItem"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="26"/></Style>
</Application.Styles>
</Application>
