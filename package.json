{
  "name": "forterm",
  "version": "0.1.7",
  "private": true,
  "description": "Forterm — 堡垒机终端与文件管理",
  "author": "Forterm",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "diagnose": "electron . --diagnose",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts electron-builder.yml",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/smoke.mjs",
    "test:burst": "node scripts/burst-smoke.mjs",
    "launchers": "node scripts/launchers.mjs",
    "dist:win": "npm run build && npm run launchers && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac dir --arm64",
    "test:workspace": "node --import tsx scripts/three-column-smoke.mts",
    "test:layout": "node --import tsx scripts/three-column-smoke.mts",
    "test:reachability": "node --import tsx scripts/reachability-smoke.mts",
    "test:upload-queue": "node --import tsx scripts/upload-queue-smoke.mts",
    "test:accounts": "node --import tsx scripts/accounts-smoke.mts",
    "test:workbench": "node --import tsx scripts/workbench-smoke.mts",
    "test:clipboard": "node --import tsx scripts/clipboard-smoke.mts",
    "test:lifecycle": "node --import tsx scripts/three-column-smoke.mts",
    "test:bom-history": "node --import tsx scripts/bom-history-smoke.mts",
    "test:file-guards": "node --import tsx scripts/file-guards-smoke.mts",
    "test:bastion-access": "node --import tsx scripts/bastion-access-smoke.mts",
    "test:linked-tabs": "node --import tsx scripts/three-column-smoke.mts",
    "test:three-columns": "node --import tsx scripts/three-column-smoke.mts",
    "test:navigation": "node --import tsx scripts/navigation-collapse-smoke.mts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "^6.2.3",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
